<?xml version="1.0" encoding="UTF-8"?>
<Scheme>
   <BuildAction
      buildConfiguration = "Debug">
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Script"
               scriptText = "rm -fr $INSTALL_PATH/$TARGET_NAME.mdimporter
mv $TARGET_BUILD_DIR/$TARGET_NAME.mdimporter  $INSTALL_PATH/
">
            </ActionContent>
         </ExecutionAction>
      </PostActions>
      <BuildableProductReferences>
         <BuildableProductReference
            BuildableProductIdentifier = "LibSpotlight.mdimporter">
         </BuildableProductReference>
      </BuildableProductReferences>
   </BuildAction>
   <TestAction>
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Script"
               scriptText = "rm -fr $INSTALL_PATH/$TARGET_NAME.mdimporter
mv $TARGET_BUILD_DIR/$TARGET_NAME.mdimporter  $INSTALL_PATH/
">
            </ActionContent>
         </ExecutionAction>
      </PostActions>
   </TestAction>
   <LaunchAction
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.GDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.GDB">
      <AdditionalOptions>
      </AdditionalOptions>
   </LaunchAction>
</Scheme>
