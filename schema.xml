<?xml version="1.0" encoding="UTF-8"?>
 
<schema version="1.0" xmlns="http://www.apple.com/metadata"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xsi:schemaLocation="http://www.apple.com/metadata file:///System/Library/Frameworks/CoreServices.framework/Frameworks/Metadata.framework/Resources/MetadataSchema.xsd">
    <note>
        Custom attributes that this metadata importer supports.  Below
	is an example of a multivalued string attribute.  Other types
	are CFNumber, CFDate, CFBoolean and CFData.		      
    </note>
    <attributes>
		<attribute name="com_polymicrosystems_objectfile_path" multivalued="false" type="CFString"/>
		<attribute name="com_polymicrosystems_objectfile_export_symbols" multivalued="false" type="CFString"/>
		<attribute name="com_polymicrosystems_objectfile_import_symbols" multivalued="false" type="CFString"/>
    </attributes>

    <types>
        <type name="public.object-file">
            <note>
				The keys that this metadata importer handles.
            </note>
            <allattrs>
				kMDItemTitle
				kMDItemDisplayName
				kMDItemKind
				com_polymicrosystems_objectfile_path
				com_polymicrosystems_objectfile_export_symbols
				com_polymicrosystems_objectfile_import_symbols
            </allattrs>
            <displayattrs>
				kMDItemTitle
				kMDItemDisplayName
				kMDItemKind
				com_polymicrosystems_objectfile_path
				com_polymicrosystems_objectfile_export_symbols
				com_polymicrosystems_objectfile_import_symbols
            </displayattrs>
        </type>
    </types>
</schema>

